NODE_ENV=development
NODE_PORT=3000
PUBLIC_URL=http://localhost:3000

COMMUNITY_NAME=Example Community
COMMUNITY_HEADLINE=Meet, share, and solve it together.
COMMUNITY_DESCRIPTION=Join the community to ask questions, exchange ideas, and connect with people on Slack.
COMMUNITY_WEBSITE_URL=https://example.com
COMMUNITY_LOGO_URL=
COMMUNITY_SUPPORT_URL=
COMMUNITY_PRIVACY_URL=
SOCIAL_IMAGE_URL=

SLACK_TEAM=your-workspace
SLACK_TOKEN=replace-with-existing-legacy-admin-token

# Optional but recommended. Remove both keys to run without Turnstile.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_EXPECTED_HOSTNAME=

TRUST_PROXY=false
RATE_LIMIT_IP_MAX=10
RATE_LIMIT_IP_WINDOW_SECONDS=3600
RATE_LIMIT_EMAIL_MAX=3
RATE_LIMIT_EMAIL_WINDOW_SECONDS=86400
